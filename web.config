<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <!-- اگر PHP شما جای دیگری نصب است، این مسیر را عوض کنید -->
            <add name="PHP_via_FastCGI" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\php\php-cgi.exe" resourceType="Unspecified" />
        </handlers>

        <defaultDocument>
            <files>
                <clear />
                <add value="index.html" />
                <add value="index.php" />
                <add value="Default.htm" />
                <add value="Default.asp" />
                <add value="index.htm" />
                <add value="iisstart.htm" />
                <add value="default.aspx" />
            </files>
        </defaultDocument>

        <httpErrors errorMode="Detailed" />

        <security>
            <requestFiltering>
                <!-- سقف مجاز حجم درخواست و آپلود فایل: ۱۰۰ مگابایت -->
                <requestLimits maxAllowedContentLength="104857600" />

                <!--
                  پوشه‌های داخلی سایت از بیرون قابل دسترسی نباشند.
                  data/users.json هش رمز عبور دارد و database/schema.mysql.sql
                  ساختار دیتابیس را لو می‌دهد؛ هیچ‌کدام نباید با URL باز شوند.
                -->
                <hiddenSegments>
                    <add segment="includes" />
                    <add segment="data" />
                    <add segment="tools" />
                    <add segment="database" />
                </hiddenSegments>

                <!-- پسوند‌هایی که هرگز نباید سرو شوند -->
                <fileExtensions>
                    <add fileExtension=".sqlite" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".json" allowed="false" />
                    <add fileExtension=".lock" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>

        <staticContent>
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <remove fileExtension=".ttf" />
            <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
        </staticContent>

        <!-- فشرده‌سازی برای فایل‌های متنی -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    </system.webServer>
</configuration>
